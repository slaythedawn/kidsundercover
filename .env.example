# Copy to .env.local for local development. On Vercel, set these in Settings > Environment Variables.
# See docs/FORMS.md.

# Website database: Neon Postgres (Sydney), added through the Vercel Marketplace, which sets this automatically.
DATABASE_URL=

# Optional, not planned for now: email each submission to KUC (Resend, free plan).
# Staff notifications will come from KUC's CRM instead.
RESEND_API_KEY=
FORMS_FROM="Kids Under Cover website <website@kuc.org.au>"
# Testing only: send every form email here instead of the KUC inboxes.
FORMS_TO_OVERRIDE=

# Optional: spam protection (Cloudflare Turnstile, free).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lets staff download submissions: /api/forms/export/?form=contact&token=...
FORMS_ADMIN_TOKEN=

# Optional. Without a key, the homepage assistant uses its built in answers.
# With a key, free text questions are answered by Claude using only the facts in content/home.ts.
ANTHROPIC_API_KEY=
